# JARVIS Configuration
# The app has a built-in API key — it works out of the box.
# Copy this file to .env ONLY if you want to use your own key.

# OpenRouter API Key (get yours free at https://openrouter.ai/keys)
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# OpenRouter Base URL (optional)
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Default model (auto-failover: if this one is busy/removed JARVIS falls back
# to the next working free model automatically)
JARVIS_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# Governance Level: 0=Low, 1=Medium, 2=High
JARVIS_GOVERNANCE_LEVEL=1

# Python executable path (optional)
JARVIS_PYTHON_PATH=python

# ---------- Voice (STT / TTS) ----------
# TTS engine: auto (default: edge-tts British JARVIS voice, SAPI fallback)
#             edge  = force the online neural voice
#             sapi  = offline Windows voice (instant, no network)
JARVIS_TTS=auto

# edge-tts voice used when JARVIS_TTS=auto|edge
JARVIS_TTS_VOICE=en-GB-RyanNeural

# Primary speech-recognition language (ar-SA is always tried in parallel too)
JARVIS_STT_LANG=en-US

# Microphone device index (omit to use the Windows default input device)
# List devices: python -c "import sounddevice as sd; print(sd.query_devices())"
#JARVIS_MIC_DEVICE=1
