# JARVIS Configuration
# The app has a built-in API key — it works out of the box.
# Copy this file to .env ONLY if you want to use your own key.

# ── Recommended: add your key from the GUI ──
# File > Settings > "PROVIDER API KEY": paste an NVIDIA (nvapi-…) or
# OpenRouter (sk-or-…) key. The provider is auto-detected and the key is
# saved to %APPDATA%\JarvisAssistant\config.json (outside the repo).
# The GUI beats .env: values saved there override everything below.

# NVIDIA NIM API key (free tier: https://build.nvidia.com/ -> Get API Key)
#NVIDIA_API_KEY=nvapi-your-key-here

# OpenRouter API Key (get yours free at https://openrouter.ai/keys)
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# OpenRouter Base URL (optional)
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Provider: nvidia | openrouter (auto-detected from the saved key)
#JARVIS_PROVIDER=nvidia

# Default model (auto-failover: if this one is busy/removed JARVIS falls back
# to the next working model — NVIDIA presets first, then free OpenRouter)
# NVIDIA: nvidia/nemotron-3-super-120b-a12b (fastest, ~1.6s, correct JSON)
JARVIS_MODEL=nvidia/nemotron-3-super-120b-a12b

# Governance Level: 0=Low, 1=Medium, 2=High
JARVIS_GOVERNANCE_LEVEL=1

# Python executable path (optional)
JARVIS_PYTHON_PATH=python

# ---------- Voice (STT / TTS) ----------
# TTS engine: auto (default: edge-tts British JARVIS voice, SAPI fallback)
#             edge  = force the online neural voice
#             sapi  = offline Windows voice (instant, no network)
JARVIS_TTS=auto

# edge-tts voice used when JARVIS_TTS=auto|edge
# (DIVA defaults to the female en-GB-SoniaNeural; override here to change JARVIS)
JARVIS_TTS_VOICE=en-GB-RyanNeural

# Optional TTS shaping (defaults shown; DIVA uses rate -3%, pitch +0Hz)
#JARVIS_TTS_RATE=-5%
#JARVIS_TTS_PITCH=-5Hz

# Offline SAPI fallback voice preference: female | male
# (DIVA sets "female" so the offline voice stays a woman's voice)
#JARVIS_TTS_SAPI_GENDER=female

# Data/config directory name under %APPDATA% (default: JarvisAssistant).
# diva_app sets this to DivaAssistant automatically before importing engines.
#JARVIS_APPDATA_DIR=JarvisAssistant

# Primary speech-recognition language (ar-SA is always tried in parallel too)
JARVIS_STT_LANG=en-US

# Microphone device index (omit to use the Windows default input device)
# List devices: python -c "import sounddevice as sd; print(sd.query_devices())"
#JARVIS_MIC_DEVICE=1
